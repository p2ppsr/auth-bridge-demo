FROM node:22-bookworm-slim AS builder
WORKDIR /build

COPY packages/auth-bridge-react/package.json packages/auth-bridge-react/package-lock.json ./packages/auth-bridge-react/
WORKDIR /build/packages/auth-bridge-react
RUN npm ci --ignore-scripts
COPY packages/auth-bridge-react ./
RUN npm run build

WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json frontend/tsconfig.json frontend/vite.config.ts frontend/index.html ./
COPY frontend/public ./public
COPY frontend/src ./src
ARG VITE_GOOGLE_CLIENT_ID=""
ENV VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}
RUN npm ci --ignore-scripts && npm run build

FROM nginx:1.27-alpine AS runtime
COPY --from=builder /build/frontend/dist /usr/share/nginx/html
COPY frontend/nginx.conf.template /etc/nginx/templates/default.conf.template
ENV PORT=8080
ENV BACKEND_HOST=auth-bridge-backend
ENV BACKEND_PORT=8080
EXPOSE 8080
CMD ["/bin/sh", "-c", "envsubst '$PORT $BACKEND_HOST $BACKEND_PORT' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
