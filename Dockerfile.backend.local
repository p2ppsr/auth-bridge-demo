FROM node:22-bookworm-slim AS builder
WORKDIR /build

RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

COPY packages/auth-bridge-express ./packages/auth-bridge-express
WORKDIR /build/packages/auth-bridge-express
RUN npm ci
RUN npm run build

WORKDIR /build/backend
COPY backend/package.json backend/package-lock.json backend/tsconfig.json ./
RUN npm ci
COPY backend/src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
COPY --from=builder /build/packages /app/packages
COPY --from=builder /build/backend /app/backend
WORKDIR /app/backend
EXPOSE 8080
CMD ["node", "dist/server.js"]
